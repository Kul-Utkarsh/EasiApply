# --- Browser Automation Settings ---
HEADLESS=False
USER_DATA_DIR="./user_data"
SLOW_MO_MS=100

# --- Safety Limits ---
MAX_JOBS_PER_SESSION=25
MIN_PAGE_DELAY=3
MAX_PAGE_DELAY=8

# --- Search Defaults ---
DEFAULT_KEYWORDS="Product Designer"
DEFAULT_LOCATION="Remote"

# --- AI Provider Settings (any OpenAI-compatible gateway or local model) ---
AI_PROVIDER="custom"
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""
# Optional per-feature model overrides (fall back to AI_MODEL when empty)
AI_MODEL_SCORING=""
AI_MODEL_DRAFTS=""
# Presets: omniroute | openai (https://api.openai.com/v1)
#          openrouter (https://openrouter.ai/api/v1)
#          ollama (http://localhost:11434/v1, no key needed) | custom
# Legacy keys still read as fallback: OMNIROUTE_BASE_URL, OMNIROUTE_API_KEY, CLAUDE_MODEL

# --- Email (SMTP) Settings ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SENDER_NAME="Your Name"
SENDER_EMAIL="your-email@gmail.com"
